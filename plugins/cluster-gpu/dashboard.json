{
  "title": "hostmon operations",
  "defaultWindowSeconds": 3600,
  "navigation": [
    {"id": "overview", "label": "Overview", "group": "Charts"},
    {"id": "gpu-fleet", "label": "GPU Fleet", "group": "Charts"},
    {"id": "workloads", "label": "Workloads", "group": "Tables"},
    {"id": "metrics", "label": "Metrics", "group": "Tables"},
    {"id": "collectors", "label": "Collectors", "group": "Tables"},
    {"id": "kubernetes", "label": "Kubernetes", "group": "Tables"},
    {"id": "alerts", "label": "Alerts", "group": "Manage"},
    {"id": "settings", "label": "Settings", "placement": "bottom"},
    {"id": "sections", "label": "Sections", "placement": "bottom"},
    {"id": "system", "label": "System", "placement": "bottom"}
  ],
  "panels": [
    {
      "id": "overview",
      "type": "stats",
      "page": "overview",
      "title": "Current resource state",
      "columnSpan": 2,
      "metrics": [
        {"metric": "cpu/percent", "label": "CPU", "unit": "%", "decimals": 1},
        {"metric": "memory/percent", "label": "Memory", "unit": "%", "decimals": 1},
        {"metric": "disk/percent", "label": "Disk", "unit": "%", "decimals": 1},
        {"metric": "gpu/percent", "label": "GPU", "unit": "%", "decimals": 1},
        {"metric": "gpu/memory_percent", "label": "GPU memory", "unit": "%", "decimals": 1},
        {"metric": "gpu/temperature_c", "label": "GPU temperature", "unit": "C", "decimals": 0},
        {"metric": "network/rx_mbps", "label": "Network RX", "unit": "Mbps", "decimals": 2},
        {"metric": "network/tx_mbps", "label": "Network TX", "unit": "Mbps", "decimals": 2}
      ]
    },
    {
      "id": "host-utilization",
      "type": "timeseries",
      "page": "overview",
      "title": "Host utilization",
      "metrics": ["cpu/percent", "memory/percent", "disk/percent"],
      "series": {
        "cpu/percent": {"label": "CPU"},
        "memory/percent": {"label": "Memory"},
        "disk/percent": {"label": "Disk"}
      },
      "range": [0, 100]
    },
    {
      "id": "network",
      "type": "timeseries",
      "page": "overview",
      "title": "Network throughput",
      "metrics": ["network/rx_mbps", "network/tx_mbps"],
      "series": {
        "network/rx_mbps": {"label": "Network RX"},
        "network/tx_mbps": {"label": "Network TX"}
      }
    },
    {
      "id": "gpu",
      "type": "timeseries",
      "page": "overview",
      "title": "GPU",
      "metrics": ["gpu/percent", "gpu/memory_percent", "gpu/temperature_c"],
      "series": {
        "gpu/percent": {"label": "GPU"},
        "gpu/memory_percent": {"label": "GPU memory"},
        "gpu/temperature_c": {"label": "GPU temperature"}
      },
      "range": [0, 100]
    },
    {
      "id": "pressure",
      "type": "timeseries",
      "page": "overview",
      "title": "Resource pressure (PSI avg10)",
      "metrics": ["pressure/cpu/some_avg10", "pressure/io/some_avg10", "pressure/memory/some_avg10"],
      "series": {
        "pressure/cpu/some_avg10": {"label": "CPU pressure"},
        "pressure/io/some_avg10": {"label": "I/O pressure"},
        "pressure/memory/some_avg10": {"label": "Memory pressure"}
      },
      "range": [0, 100]
    },
    {
      "id": "kubernetes",
      "type": "timeseries",
      "page": "kubernetes",
      "title": "Kubernetes GPU nodes",
      "metrics": ["k8s/occupied_gpu_nodes", "k8s/quota_nodes"],
      "series": {
        "k8s/occupied_gpu_nodes": {"label": "Occupied nodes"},
        "k8s/quota_nodes": {"label": "Node quota"}
      }
    },
    {
      "id": "collectors",
      "type": "collectors",
      "page": "collectors",
      "title": "Collector health",
      "columnSpan": 2,
      "columns": [
        {"id": "name", "label": "Collector", "path": "name", "width": "220px", "mobileWidth": "160px", "align": "left", "pinned": true, "sort": "name"},
        {"id": "state", "label": "State", "path": "state", "width": "90px", "mobileWidth": "70px", "align": "center", "format": "state", "sort": "state"},
        {"id": "duration", "label": "Last duration", "path": "duration", "width": "130px", "format": "number", "unit": "ms", "sort": "duration"},
        {"id": "refresh", "label": "Interval", "path": "refresh_seconds", "width": "100px", "format": "duration", "sort": "refresh_seconds"},
        {"id": "updated", "label": "Last data refresh (UTC+8)", "path": "last_success_at", "width": "190px", "format": "timestamp", "sort": "last_success_at"},
        {"id": "failures", "label": "Failures", "path": "failures", "width": "90px", "format": "number", "sort": "failures"},
        {"id": "failed", "label": "Last failure (UTC+8)", "path": "last_failure_at", "width": "180px", "format": "timestamp", "sort": "last_failure_at"},
        {"id": "log", "label": "Last error", "path": "last_error", "width": "300px", "align": "left", "fallback": "None"},
        {"id": "details", "label": "", "width": "70px", "align": "center", "pinned": "right", "action": "details"}
      ]
    },
    {
      "id": "tasks",
      "type": "tasks",
      "page": "kubernetes",
      "title": "Kubernetes task state",
      "columnSpan": 2,
      "items": [
        {
          "label": "GPU nodes",
          "template": "{occupied} / {quota}",
          "values": {
            "occupied": {"source": "metric", "key": "k8s/occupied_gpu_nodes"},
            "quota": {"source": "metric", "key": "k8s/quota_nodes"}
          }
        },
        {"label": "Stopped or reduced", "template": "{value}", "values": {"value": {"source": "field", "key": "k8s_stopped_tasks", "fallback": "(none)"}}},
        {"label": "Lost nodes", "template": "{value}", "values": {"value": {"source": "field", "key": "k8s_stopped_task_details", "fallback": "(none)"}}},
        {"label": "Failed tasks", "template": "{value}", "values": {"value": {"source": "field", "key": "k8s_failed_tasks", "fallback": "(none)"}}},
        {
          "label": "Permission checks",
          "template": "{counts} granted",
          "values": {
            "counts": {"source": "metricMatch", "prefix": "permission/", "suffix": "/allowed", "equals": 1}
          }
        }
      ]
    },
    {
      "id": "gpu-fleet",
      "type": "plugin-summary",
      "plugin": "cluster_gpu_usage",
      "page": "gpu-fleet",
      "title": "Queue capacity and allocation",
      "columnSpan": 2,
      "summary": [
        {"label": "GPU allocation", "path": "gpu_allocation"},
        {"label": "Utilization", "path": "utilization_percent", "format": "number", "unit": "%"},
        {"label": "Pending GPUs", "path": "pending_gpus", "format": "number"},
        {"label": "No-job GPUs", "path": "no_job_gpus", "format": "number"},
        {"label": "No-job nodes", "path": "no_job_node_equivalents", "format": "number"},
        {"label": "Free CPUs", "path": "free_cpus", "format": "number"}
      ],
      "columns": [
        {"id": "queue", "label": "Queue", "path": "queue", "width": "120px", "align": "left", "sort": "queue"},
        {"id": "gpu_allocation", "label": "GPU allocation", "path": "gpu_allocation", "width": "180px", "align": "left"},
        {"id": "utilization", "label": "Usage", "path": "utilization_percent", "width": "120px", "format": "number", "unit": "%", "sort": "utilization_percent"},
        {"id": "pending", "label": "Pending", "path": "pending_gpus", "width": "100px", "format": "number", "sort": "pending_gpus"},
        {"id": "free", "label": "Free now", "path": "unallocated_gpus", "width": "110px", "format": "number", "sort": "unallocated_gpus"},
        {"id": "no_job", "label": "No-job GPUs", "path": "no_job_gpus", "width": "120px", "format": "number", "sort": "no_job_gpus"},
        {"id": "no_job_nodes", "label": "No-job nodes", "path": "no_job_node_equivalents", "width": "120px", "format": "number"},
        {"id": "cpu_allocation", "label": "CPU allocation", "path": "cpu_allocation", "width": "190px", "align": "left"},
        {"id": "free_cpus", "label": "Free CPUs", "path": "free_cpus", "width": "110px", "format": "number", "sort": "free_cpus"}
      ]
    },
    {
      "id": "gpu-capacity-history",
      "type": "timeseries",
      "page": "gpu-fleet",
      "title": "GPU capacity history",
      "columnSpan": 1,
      "height": 300,
      "metrics": ["cluster_gpu/queue/total/capacity_gpus", "cluster_gpu/queue/total/allocated_gpus"],
      "series": {
        "cluster_gpu/queue/total/capacity_gpus": {"label": "GPU capacity"},
        "cluster_gpu/queue/total/allocated_gpus": {"label": "Allocated GPUs"}
      }
    },
    {
      "id": "gpu-availability-history",
      "type": "timeseries",
      "page": "gpu-fleet",
      "title": "GPU availability and demand",
      "columnSpan": 1,
      "height": 300,
      "metrics": [
        "cluster_gpu/queue/total/pending_gpus",
        "cluster_gpu/queue/total/unallocated_gpus",
        "cluster_gpu/queue/total/no_job_gpus",
        "cluster_gpu/queue/total/no_job_node_equivalents"
      ],
      "series": {
        "cluster_gpu/queue/total/pending_gpus": {"label": "Pending GPUs"},
        "cluster_gpu/queue/total/unallocated_gpus": {"label": "Free GPUs"},
        "cluster_gpu/queue/total/no_job_gpus": {"label": "No-job GPUs"},
        "cluster_gpu/queue/total/no_job_node_equivalents": {"label": "No-job nodes"}
      }
    },
    {
      "id": "gpu-submitters",
      "type": "plugin-records",
      "plugin": "cluster_gpu_usage",
      "page": "workloads",
      "title": "GPU workloads",
      "columnSpan": 2,
      "defaultSort": "running_gpus",
      "defaultSortDirection": "desc",
      "columns": [
        {"id": "queue", "label": "Queue", "path": "queue", "width": "96px", "align": "left", "sort": "queue"},
        {"id": "name", "label": "Workload", "path": "name", "width": "410px", "mobileWidth": "160px", "align": "left", "pinned": true, "sort": "name", "action": "details"},
        {"id": "status", "label": "State", "path": "status", "width": "100px", "align": "center", "format": "state"},
        {"id": "submitter", "label": "Submitter", "path": "submitter", "width": "280px", "align": "left", "sort": "submitter"},
        {"id": "running_gpus", "label": "Running GPUs", "path": "running_gpus", "width": "130px", "format": "number", "sort": "running_gpus"},
        {"id": "running_gpu_nodes", "label": "GPU nodes", "path": "running_gpu_nodes", "width": "130px", "format": "number"},
        {"id": "pending_gpus", "label": "Pending GPUs", "path": "pending_gpus", "width": "130px", "format": "number", "sort": "pending_gpus"}
      ]
    },
    {
      "id": "metric-explorer",
      "type": "metrics",
      "page": "metrics",
      "title": "Metric explorer",
      "columnSpan": 2,
      "columns": [
        {"id": "select", "label": "", "width": "48px", "align": "center", "pinned": "left", "action": "select"},
        {"id": "name", "label": "Metric", "path": "name", "width": "480px", "mobileWidth": "140px", "align": "left", "pinned": true, "sort": "name"},
        {"id": "current", "label": "Current", "path": "current", "width": "140px", "mobileWidth": "110px", "format": "metric", "sort": "current"},
        {"id": "minimum", "label": "Min", "path": "minimum", "width": "140px", "mobileWidth": "110px", "format": "metric", "sort": "minimum"},
        {"id": "average", "label": "Average", "path": "average", "width": "140px", "mobileWidth": "110px", "format": "metric", "sort": "average"},
        {"id": "p95", "label": "P95", "path": "p95", "width": "140px", "mobileWidth": "110px", "format": "metric", "sort": "p95"},
        {"id": "maximum", "label": "Max", "path": "maximum", "width": "140px", "mobileWidth": "110px", "format": "metric", "sort": "maximum"},
        {"id": "samples", "label": "Samples", "path": "samples", "width": "90px", "mobileWidth": "80px", "format": "number", "sort": "samples"}
      ]
    },
    {
      "id": "alert-rules",
      "type": "rules",
      "page": "alerts",
      "title": "Alert rules",
      "columnSpan": 2,
      "columns": [
        {"id": "enabled", "label": "", "width": "52px", "align": "center", "pinned": "left", "action": "enabled"},
        {"id": "alert", "label": "Alert", "path": "alert", "width": "260px", "mobileWidth": "130px", "align": "left", "pinned": true, "sort": "alert"},
        {"id": "level", "label": "Level", "path": "level", "width": "110px", "align": "left", "sort": "level"},
        {"id": "expr", "label": "Expression", "path": "expr", "width": "620px", "align": "left", "sort": "expr"},
        {"id": "actions", "label": "", "width": "120px", "pinned": "right", "action": "actions"}
      ]
    },
    {"id": "web-settings", "type": "web-settings", "page": "settings", "title": "Web settings", "columnSpan": 2},
    {"id": "sections", "type": "sections", "page": "sections", "section": "Configuration", "title": "Sections and metric pages", "columnSpan": 2},
    {
      "id": "system",
      "type": "system",
      "page": "system",
      "title": "System and API status",
      "columnSpan": 2,
      "items": [
        {"label": "Host", "template": "{value}", "values": {"value": {"source": "system", "key": "host"}}},
        {"label": "Version", "template": "{value}", "values": {"value": {"source": "system", "key": "version"}}},
        {"label": "Latest sample", "template": "{value}", "values": {"value": {"source": "system", "key": "updated_at"}}},
        {"label": "Metrics endpoint", "template": "{value}", "values": {"value": {"source": "static", "value": "/metrics"}}},
        {"label": "Health API", "template": "{value}", "values": {"value": {"source": "static", "value": "/healthz"}}},
        {"label": "Status API", "template": "{value}", "values": {"value": {"source": "static", "value": "/api/status"}}},
        {"label": "History API", "template": "{value}", "values": {"value": {"source": "static", "value": "/api/history"}}},
        {"label": "WebSocket", "template": "{value}", "values": {"value": {"source": "static", "value": "/api/ws"}}}
      ],
      "metricFilter": {"prefix": "monitor/"}
    }
  ]
}
