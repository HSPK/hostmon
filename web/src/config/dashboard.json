{
  "title": "hostmon operations",
  "defaultWindowSeconds": 3600,
  "navigation": [
    {"id": "overview", "label": "Overview", "group": "Charts"},
    {"id": "metrics", "label": "Metrics", "group": "Tables"},
    {"id": "collectors", "label": "Collectors", "group": "Tables"},
    {"id": "alerts", "label": "Alerts", "group": "Manage"},
    {"id": "layouts", "label": "Layouts", "placement": "bottom"},
    {"id": "settings", "label": "Settings", "placement": "bottom"},
    {"id": "system", "label": "System", "placement": "bottom"}
  ],
  "panels": [
    {
      "id": "overview",
      "type": "stats",
      "page": "overview",
      "title": "Current resource state",
      "columnSpan": 2,
      "metrics": [
        {"metric": "cpu/percent", "label": "CPU", "unit": "%", "decimals": 1},
        {"metric": "memory/percent", "label": "Memory", "unit": "%", "decimals": 1},
        {"metric": "disk/percent", "label": "Disk", "unit": "%", "decimals": 1},
        {"metric": "gpu/percent", "label": "GPU", "unit": "%", "decimals": 1},
        {"metric": "gpu/memory_percent", "label": "GPU memory", "unit": "%", "decimals": 1},
        {"metric": "gpu/temperature_c", "label": "GPU temperature", "unit": "C", "decimals": 0},
        {"metric": "network/rx_mbps", "label": "Network RX", "unit": "Mbps", "decimals": 2},
        {"metric": "network/tx_mbps", "label": "Network TX", "unit": "Mbps", "decimals": 2}
      ]
    },
    {
      "id": "host-utilization",
      "type": "timeseries",
      "page": "overview",
      "title": "Host utilization",
      "metrics": ["cpu/percent", "memory/percent", "disk/percent"],
      "series": {
        "cpu/percent": {"label": "CPU"},
        "memory/percent": {"label": "Memory"},
        "disk/percent": {"label": "Disk"}
      },
      "range": [0, 100]
    },
    {
      "id": "network",
      "type": "timeseries",
      "page": "overview",
      "title": "Network throughput",
      "metrics": ["network/rx_mbps", "network/tx_mbps"],
      "series": {
        "network/rx_mbps": {"label": "Network RX"},
        "network/tx_mbps": {"label": "Network TX"}
      }
    },
    {
      "id": "gpu",
      "type": "timeseries",
      "page": "overview",
      "title": "GPU",
      "metrics": ["gpu/percent", "gpu/memory_percent", "gpu/temperature_c"],
      "series": {
        "gpu/percent": {"label": "GPU"},
        "gpu/memory_percent": {"label": "GPU memory"},
        "gpu/temperature_c": {"label": "GPU temperature"}
      },
      "range": [0, 100]
    },
    {
      "id": "pressure",
      "type": "timeseries",
      "page": "overview",
      "title": "Resource pressure (PSI avg10)",
      "metrics": ["pressure/cpu/some_avg10", "pressure/io/some_avg10", "pressure/memory/some_avg10"],
      "series": {
        "pressure/cpu/some_avg10": {"label": "CPU pressure"},
        "pressure/io/some_avg10": {"label": "I/O pressure"},
        "pressure/memory/some_avg10": {"label": "Memory pressure"}
      },
      "range": [0, 100]
    },
    {
      "id": "collectors",
      "type": "collectors",
      "page": "collectors",
      "title": "Collector health",
      "columnSpan": 2,
      "columns": [
        {"id": "name", "label": "Collector", "path": "name", "width": "220px", "mobileWidth": "160px", "align": "left", "pinned": true, "sort": "name"},
        {"id": "state", "label": "State", "path": "state", "width": "90px", "mobileWidth": "70px", "align": "center", "format": "state", "sort": "state"},
        {"id": "duration", "label": "Last duration", "path": "duration", "width": "130px", "format": "number", "unit": "ms", "sort": "duration"},
        {"id": "refresh", "label": "Interval", "path": "refresh_seconds", "width": "100px", "format": "duration", "sort": "refresh_seconds"},
        {"id": "updated", "label": "Last data refresh (UTC+8)", "path": "last_success_at", "width": "190px", "format": "timestamp", "sort": "last_success_at"},
        {"id": "failures", "label": "Failures", "path": "failures", "width": "90px", "format": "number", "sort": "failures"},
        {"id": "failed", "label": "Last failure (UTC+8)", "path": "last_failure_at", "width": "180px", "format": "timestamp", "sort": "last_failure_at"},
        {"id": "log", "label": "Last error", "path": "last_error", "width": "300px", "align": "left", "fallback": "None"},
        {"id": "details", "label": "", "width": "70px", "align": "center", "pinned": "right", "action": "details"}
      ]
    },
    {
      "id": "metric-explorer",
      "type": "metrics",
      "page": "metrics",
      "title": "Metric explorer",
      "columnSpan": 2,
      "columns": [
        {"id": "select", "label": "", "width": "48px", "align": "center", "pinned": "left", "action": "select"},
        {"id": "name", "label": "Metric", "path": "name", "width": "480px", "mobileWidth": "140px", "align": "left", "pinned": true, "sort": "name"},
        {"id": "current", "label": "Current", "path": "current", "width": "140px", "mobileWidth": "110px", "format": "metric", "sort": "current"},
        {"id": "minimum", "label": "Min", "path": "minimum", "width": "140px", "mobileWidth": "110px", "format": "metric", "sort": "minimum"},
        {"id": "average", "label": "Average", "path": "average", "width": "140px", "mobileWidth": "110px", "format": "metric", "sort": "average"},
        {"id": "p95", "label": "P95", "path": "p95", "width": "140px", "mobileWidth": "110px", "format": "metric", "sort": "p95"},
        {"id": "maximum", "label": "Max", "path": "maximum", "width": "140px", "mobileWidth": "110px", "format": "metric", "sort": "maximum"},
        {"id": "samples", "label": "Samples", "path": "samples", "width": "90px", "mobileWidth": "80px", "format": "number", "sort": "samples"}
      ]
    },
    {
      "id": "alert-rules",
      "type": "rules",
      "page": "alerts",
      "title": "Alert rules",
      "columnSpan": 2,
      "columns": [
        {"id": "enabled", "label": "", "width": "52px", "align": "center", "pinned": "left", "action": "enabled"},
        {"id": "alert", "label": "Alert", "path": "alert", "width": "260px", "mobileWidth": "130px", "align": "left", "pinned": true, "sort": "alert"},
        {"id": "level", "label": "Level", "path": "level", "width": "110px", "align": "left", "sort": "level"},
        {"id": "expr", "label": "Expression", "path": "expr", "width": "620px", "align": "left", "sort": "expr"},
        {"id": "actions", "label": "", "width": "120px", "pinned": "right", "action": "actions"}
      ]
    },
    {"id": "layouts", "type": "sections", "page": "layouts", "section": "Layouts", "title": "Tabs and metric pages", "columnSpan": 2},
    {"id": "web-settings", "type": "web-settings", "page": "settings", "title": "Web settings", "columnSpan": 2},
    {
      "id": "system",
      "type": "system",
      "page": "system",
      "title": "System and API status",
      "columnSpan": 2,
      "items": [
        {"label": "Host", "template": "{value}", "values": {"value": {"source": "system", "key": "host"}}},
        {"label": "Version", "template": "{value}", "values": {"value": {"source": "system", "key": "version"}}},
        {"label": "Latest sample (UTC+8)", "template": "{value}", "values": {"value": {"source": "system", "key": "updated_at", "format": "timestamp"}}},
        {"label": "Metrics endpoint", "template": "{value}", "values": {"value": {"source": "static", "value": "/metrics"}}},
        {"label": "Health API", "template": "{value}", "values": {"value": {"source": "static", "value": "/healthz"}}},
        {"label": "Status API", "template": "{value}", "values": {"value": {"source": "static", "value": "/api/status"}}},
        {"label": "History API", "template": "{value}", "values": {"value": {"source": "static", "value": "/api/history"}}},
        {"label": "WebSocket", "template": "{value}", "values": {"value": {"source": "static", "value": "/api/ws"}}}
      ],
      "metricFilter": {"prefix": "monitor/"}
    }
  ]
}
